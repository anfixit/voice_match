# Локальный запуск по умолчанию доступен только с этого компьютера.
VM_GRADIO_HOST=127.0.0.1
VM_GRADIO_PORT=7860

# Обязательны при VM_GRADIO_HOST=0.0.0.0 или другом сетевом адресе.
VM_GRADIO_AUTH_USER=
VM_GRADIO_AUTH_PASSWORD=

VM_LOG_LEVEL=INFO
VM_USE_GPU=false
VM_NUM_THREADS=4

VM_MAX_FILE_SIZE_MB=20
VM_MIN_AUDIO_DURATION=5.0
VM_MAX_AUDIO_DURATION=300.0
VM_MIN_SPEECH_SECONDS=3.0
VM_MIN_SPEECH_RATIO=0.25
VM_MAX_CLIPPING_RATIO=0.01
VM_SEGMENT_COUNT=8
VM_SEGMENT_DURATION=4.0
VM_MIN_SEGMENT_DURATION=2.0

# Не включать без валидированной TorchScript-модели и model card.
VM_ANTISPOOFING_ENABLED=false
